{
  "name": "@ainative/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "移动端：Expo + Expo Router，与 Web 共用 @ainative/api-client",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "type-check": "tsc --noEmit",
    "lint": "expo lint",
    "bundle:check": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@ainative/api-client": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "^6.0.3"
  }
}
