{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ainative;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Issuer": "ai-native-platform",
    "Audience": "ai-native-platform",
    "SigningKey": "",
    "AccessTokenLifetime": "7.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8081",
      "tauri://localhost",
      "http://tauri.localhost"
    ]
  },
  "Ai": {
    "DefaultProvider": "anthropic",
    "DefaultModel": "claude-opus-5-5",
    "Providers": {
      "anthropic": {
        "Kind": "anthropic",
        "ApiKey": "",
        "Models": [ "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5" ]
      }
    }
  },
  "Agents": {
    "MaxStepsPerRun": 16,
    "MaxOutputTokens": 16000,
    "CheckoutLease": "00:30:00",
    "RunTimeout": "00:20:00"
  },
  "Scheduler": {
    "Enabled": true,
    "MaxConcurrentRuns": 4,
    "PollInterval": "00:00:10",
    "TimerSweepInterval": "00:00:30"
  }
}
