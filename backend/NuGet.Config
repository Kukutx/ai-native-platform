<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 限制冷缓存恢复的并发连接，避免个人 runner 的网络被大量下载请求耗尽。 -->
    <add key="maxHttpRequestsPerSource" value="16" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- 禁用机器级 fallback 路径；全局包目录交给当前用户或 NUGET_PACKAGES 决定。 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

</configuration>
