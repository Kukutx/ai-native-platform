{
  "name": "@ainative/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "后端 OpenAPI 生成的 TypeScript 客户端，以及实时通道与流式对话封装；Web、桌面、移动端共用",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./realtime": "./src/realtime.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./test/resolve-ts.mjs --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  }
}
