# 复制为 .env 后填写。.env 含密钥，不要提交到仓库。

# 数据库密码：只用字母和数字（会拼进连接字符串）。可用 openssl rand -hex 24 生成。
POSTGRES_PASSWORD=

# 登录令牌的签名密钥：至少 32 个字符的随机字符串，可用 openssl rand -base64 48 生成。
# 更换后所有成员需要重新登录。
Auth__SigningKey=

# 对外端口（容器内固定 8080）。
APP_PORT=8080

# 模型：不配置时使用内置演示模型。接入 Claude 只需填写密钥。
ANTHROPIC_API_KEY=

# 其他配置都可以用环境变量覆盖，层级用两个下划线分隔，例如接入 OpenAI 兼容端点：
# Ai__Providers__deepseek__Kind=openai
# Ai__Providers__deepseek__BaseUrl=https://api.deepseek.com/v1
# Ai__Providers__deepseek__ApiKey=
# Ai__Providers__deepseek__Models__0=deepseek-chat
# Ai__DefaultProvider=deepseek
# Ai__DefaultModel=deepseek-chat
